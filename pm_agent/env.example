# pm-agent 설정. `pm-agent init`이 이 틀에 답을 채워 작업 폴더에 .env로 저장한다. .env는 git에 올리지 않는다.

# Atlassian (Jira, Confluence 공용). API 토큰 발급: https://id.atlassian.com/manage-profile/security/api-tokens
ATLASSIAN_SITE=https://your-site.atlassian.net
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=

JIRA_PROJECT_KEY=
CONFLUENCE_SPACE_KEY=

# Slack 알림(선택). 봇 토큰(xoxb-)과 알림을 받을 채널 이름. 토큰을 비우면 알림 없이 동작한다
# 앱은 레포의 slack-app-manifest.yaml로 만들 수 있다
SLACK_BOT_TOKEN=
SLACK_CHANNEL=

# 모델 호출 방식: claude-cli(Claude Code 구독 로그인), api(Anthropic API 키), codex-cli(Codex 로그인)
# claude-cli, codex-cli는 실행하는 컴퓨터에 로그인된 계정을 쓴다. 여러 사람이 쓰는 서버라면 api로 바꾼다
LLM_BACKEND=claude-cli
# 비워 두면 claude-sonnet-5-5(codex-cli는 Codex 기본 모델)
LLM_MODEL=
# LLM_BACKEND=api일 때만 필요
ANTHROPIC_API_KEY=

# 이슈 양식 폴더. 비워 두면 작업 폴더의 templates/, 그것도 없으면 패키지의 기본 양식을 쓴다
# 양식 파일의 issue_types에는 Jira 프로젝트의 유형 이름을 그대로 적는다(영어 Jira면 Story, Task, Bug, Subtask)
TEMPLATE_DIR=

# 버그 유형 이름. 비워 두면 '버그' 또는 'Bug'. 다른 유형은 Jira 계층 번호로 구분해서 이름을 적을 필요가 없다
BUG_ISSUE_TYPE=
# 내 직군의 Jira 컴포넌트 이름. 회의록에 이 직군이 담당으로 적힌 이슈는 API 토큰 주인을 담당자로 넣는다
# 비워 두면 담당자 칸을 채우지 않는다
SELF_ASSIGN_COMPONENT=

# Confluence 자동화 규칙과 맞춰야 하는 값. 비워 두면 괄호 안 기본값
# 회의록에 붙이는 라벨(회의록), 도구가 검토 문서에 붙이는 라벨(이슈검토), 끝났다는 신호로 쓰는 페이지 상태 이름(확인됨, 영어 화면은 Verified)
MEETING_LABEL=
REVIEW_LABEL=
DONE_STATUS=

# 서버(pm-agent serve): Confluence 자동화 웹 요청이 헤더 X-PM-Agent-Secret에 실어 보내는 비밀 값
WEBHOOK_SECRET=
